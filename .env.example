# StudyFlow AI — environment variables
#
# Copy to `.env` for local development (Vite reads VITE_* at build time).
# Only VITE_* values are exposed to the browser — they must be PUBLIC.
# Never put service-role keys or LLM API keys in VITE_* variables.

# --- Supabase (required for a real backend) ---------------------------------
# Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- AI assistant (optional) -------------------------------------------------
# URL of the deployed `assistant` edge function, e.g.
#   https://your-project-ref.supabase.co/functions/v1/assistant
# When unset, the app runs the built-in rule-based assistant and says so.
VITE_ASSISTANT_URL=

# --- Server-side only (set with `supabase secrets set`, NEVER in VITE_*) -----
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
